---
import { site } from '../../data/site';
import Logo from './Logo.astro';
import Button from '../ui/Button.astro';
---
<header class="header">
  <div class="container header__inner">
    <Logo />
    <nav class="nav" aria-label="Основная">
      <a href="/#catalog">Каталог</a>
      <a href="/how-to-buy">Как купить</a>
      <a href="/about">О нас</a>
    </nav>
    <Button href={site.telegram} variant="secondary" size="sm">Telegram</Button>
  </div>
</header>
<style>
  .header {
    position: sticky; top: 0; z-index: 20;
    backdrop-filter: blur(12px);
    background: rgba(248, 250, 252, 0.85);
    border-bottom: 1px solid var(--border);
  }
  .header__inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; min-height: 68px;
  }
  .nav { display: flex; gap: 1.1rem; font-weight: 600; font-size: 0.95rem; }
  .nav a { text-decoration: none; color: var(--text-muted); }
  .nav a:hover { color: var(--text); }
  @media (max-width: 720px) {
    .nav { display: none; }
  }
</style>
