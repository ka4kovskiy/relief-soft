---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import { site } from '../../data/site';
import { getFeaturedProduct, formatPrice } from '../../data/products';
const featured = getFeaturedProduct();
---
<section class="section section-dark hero">
  <div class="container hero__grid">
    <div>
      <Badge>Relief Soft</Badge>
      <h1>Снимаем типовые боли — спокойно и без созвонов</h1>
      <p class="muted lead">{site.description}</p>
      <div class="hero__actions">
        <Button href={`/product/${featured.slug}`} size="lg">Смотреть {formatPrice(featured.price)}</Button>
        <Button href="#catalog" variant="secondary" size="lg">Каталог</Button>
      </div>
      <p class="tiny muted">Авторские материалы и файлы. Нужна ваша легальная 1С.</p>
    </div>
    <div class="hero__panel">
      <div class="orb"></div>
      <h2>{featured.title}</h2>
      <p class="muted">{featured.subtitle}</p>
      <ul>
        {featured.pains.slice(0, 3).map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </div>
</section>
<style>
  .hero { padding-top: 5rem; padding-bottom: 5rem; }
  .hero__grid {
    display: grid; gap: 2rem; align-items: center;
    grid-template-columns: 1.15fr 0.85fr;
  }
  .lead { font-size: 1.08rem; max-width: 48ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.4rem 0 0.8rem; }
  .tiny { font-size: 0.85rem; }
  .hero__panel {
    position: relative; overflow: hidden;
    border: 1px solid rgba(226,232,240,0.12);
    background: rgba(255,255,255,0.03);
    border-radius: 24px; padding: 1.6rem;
  }
  .orb {
    position: absolute; right: -40px; top: -40px; width: 160px; height: 160px;
    background: radial-gradient(circle, rgba(245,215,110,0.35), transparent 70%);
  }
  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
  }
</style>
