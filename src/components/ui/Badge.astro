---
interface Props { tone?: 'accent' | 'muted'; }
const { tone = 'accent' } = Astro.props;
---
<span class={`badge badge--${tone}`}><slot /></span>
<style>
  .badge {
    display: inline-flex; align-items: center; border-radius: 999px;
    padding: 0.25rem 0.7rem; font-size: 0.78rem; font-weight: 700;
  }
  .badge--accent { background: rgba(232, 197, 71, 0.18); color: #92400e; }
  .badge--muted { background: rgba(100, 116, 139, 0.12); color: #475569; }
</style>
